{
  "name": "@macrotracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "public",
    "data",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate-cli.js",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "gen:migration": "drizzle-kit generate",
    "gen:openapi": "tsx --conditions=development scripts/write-openapi.ts ../../openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.0.0",
    "@macrotracker/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
