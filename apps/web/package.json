{
  "name": "@macrotracker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm gen:api && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:api": "openapi-typescript ../../openapi.json -o src/api/schema.d.ts",
    "test:unit": "echo 'see e2e/'",
    "test:int": "echo 'see e2e/'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@macrotracker/shared": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.5"
  }
}
