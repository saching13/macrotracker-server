{
  "name": "@macrotracker/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./units": {
      "development": "./src/units.ts",
      "types": "./dist/units.d.ts",
      "default": "./dist/units.js"
    },
    "./diary": {
      "development": "./src/diary.ts",
      "types": "./dist/diary.d.ts",
      "default": "./dist/diary.js"
    },
    "./engine": {
      "development": "./src/engine/index.ts",
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:int": "echo 'no integration tests'"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.0"
  }
}
