# Copy is created by `make env` with real random secrets; this file only documents the keys.
POSTGRES_PASSWORD=
MT_OWNER_PASSWORD=
MT_API_PASSWORD=
# HS256 secret: GoTrue verifies the API's service-role tokens with it.
JWT_SECRET=
# JSON array of JWKs: EC P-256 private key GoTrue signs user tokens with, plus the HS256 verify key.
JWT_KEYS=
# Address people open the server at (tailnet or public). Invite/reset links use it.
PUBLIC_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Optional: which host address/port the API is published on (default 127.0.0.1:8080).
# API_BIND=0.0.0.0
# API_PORT=8080
# Optional: set when behind tailscale serve / cloudflared so client IPs are real.
# TRUST_PROXY=true
